# MEP AI NABOX Services Environment Variables
# Copy this file to .env and configure with your values

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_DB=mep_ainabox
POSTGRES_USER=mep_user
POSTGRES_PASSWORD=mep_password

# =============================================================================
# Elasticsearch Configuration
# =============================================================================
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_password

# =============================================================================
# Qdrant Configuration
# =============================================================================
QDRANT_API_KEY=qdrant_api_key

# =============================================================================
# Neo4j Configuration
# =============================================================================
NEO4J_PASSWORD=neo4j_password

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=redis_password

# =============================================================================
# MinIO Configuration
# =============================================================================
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key

# =============================================================================
# Development Services Configuration
# =============================================================================
PGADMIN_EMAIL=admin@mep.local
PGADMIN_PASSWORD=admin_password

# =============================================================================
# Monitoring Configuration
# =============================================================================
GRAFANA_PASSWORD=admin_password

# =============================================================================
# Service Ports (Optional - change if ports are already in use)
# =============================================================================
# PostgreSQL
POSTGRES_PORT=5432

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HTTPS_PORT=7473

# Redis
REDIS_PORT=6379

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Development Services
PGADMIN_PORT=8080
ELASTICSEARCH_HEAD_PORT=9100
NEO4J_BROWSER_PORT=7473
REDIS_COMMANDER_PORT=8081
MINIO_CONSOLE_UI_PORT=9002

# Monitoring Services
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# =============================================================================
# Resource Limits (Optional)
# =============================================================================
# Elasticsearch JVM Heap Size
ELASTICSEARCH_HEAP_SIZE=1g

# Neo4j Memory Settings
NEO4J_HEAP_INITIAL_SIZE=1G
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_PAGECACHE_SIZE=1G

# =============================================================================
# Security Settings (Optional)
# =============================================================================
# Enable SSL/TLS for services (requires certificates)
ENABLE_SSL=false

# API Key for service-to-service communication
SERVICE_API_KEY=service_api_key

# =============================================================================
# Backup Configuration (Optional)
# =============================================================================
# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================
# Log level for services
LOG_LEVEL=INFO

# Log retention days
LOG_RETENTION_DAYS=7

# =============================================================================
# Network Configuration (Optional)
# =============================================================================
# Docker network name
DOCKER_NETWORK_NAME=mep-services-network

# External access IP (for remote access)
EXTERNAL_ACCESS_IP=0.0.0.0 