# Jupyter Notebook checkpoints
.ipynb_checkpoints

# pyenv
.python-version

# Celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Specific MDIS files
demo_*.py
*_demo.py
demo_*.txt
*_demo.txt

# File watcher specific
watch_folder/*.txt
watch_folder/*.pdf
watch_folder/*.docx
watch_folder/*.html
watch_folder/*.json
watch_folder/*.jpg
watch_folder/*.jpeg
watch_folder/*.png
watch_folder/*.tiff
watch_folder/*.bmp

# Keep the watch folder structure but ignore contents
!watch_folder/.gitkeep

# Folder scan reports
folder_scan_report* 