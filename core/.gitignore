# MDIS Core System - Git Ignore File

# Test files and directories
test_*.py
*_test.py
test_*.txt
*_test.txt
test_*.pdf
*_test.pdf
test_*.docx
*_test.docx
test_*.html
*_test.html
test_*.json
*_test.json

# Watch folder test files
watch_folder/test_*.txt
watch_folder/*_test.txt
watch_folder/test_*.pdf
watch_folder/*_test.pdf
watch_folder/test_*.docx
watch_folder/*_test.docx
watch_folder/test_*.html
watch_folder/*_test.html

# Error files and directories
error/
error_*.txt
*_error.txt
error_*.log
*_error.log
error_*.json
*_error.json

# Processing files and directories
processed/
processing_*.txt
*_processing.txt
processing_*.log
*_processing.log
processing_*.json
*_processing.json

# Temporary files and directories
temp/
tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# Log files
logs/
*.log
*.log.*

# Database files
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.production
.env.staging

# Python cache and compiled files
