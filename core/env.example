# Core System Environment Variables
# Copy this file to .env and update the values as needed

# System Configuration
SYSTEM_ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Local File Paths (relative to the core directory)
LOCAL_DOCUMENTS_PATH=./documents
PROCESSED_DOCUMENTS_PATH=./processed
TEMP_PROCESSING_PATH=./temp
WATCH_FOLDER_PATH=./watch_folder

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mep_ainabox
POSTGRES_USER=mep_user
POSTGRES_PASSWORD=mep_password

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_password

# Qdrant Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_api_key

# Neo4j Configuration
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# MinIO Configuration
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET_NAME=documents
MINIO_USE_SSL=false

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=100

# Security Configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24
ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# External API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
HUGGINGFACE_API_TOKEN=your-huggingface-api-token

# Processing Configuration
MAX_FILE_SIZE=100MB
PARALLEL_PROCESSING=true
BATCH_SIZE=10
PROCESSING_TIMEOUT_SECONDS=300
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Module Configuration
CLIMATE_MODULE_ENABLED=true
FINANCIAL_MODULE_ENABLED=true
LEGAL_MODULE_ENABLED=false

# Climate Analysis Configuration
CLIMATE_EMISSIONS_CONFIDENCE_THRESHOLD=0.7
CLIMATE_TARGETS_CONFIDENCE_THRESHOLD=0.8
CLIMATE_RISKS_CONFIDENCE_THRESHOLD=0.75
CLIMATE_GOVERNANCE_CONFIDENCE_THRESHOLD=0.8
CLIMATE_STRATEGY_CONFIDENCE_THRESHOLD=0.75

# Financial Analysis Configuration
FINANCIAL_CONFIDENCE_THRESHOLD=0.8
FINANCIAL_RATIOS_ENABLED=true
FINANCIAL_TRENDS_ENABLED=true
FINANCIAL_PEER_COMPARISON_ENABLED=true

# Compliance Configuration
TCFD_COMPLIANCE_ENABLED=true
GRI_COMPLIANCE_ENABLED=true
SASB_COMPLIANCE_ENABLED=true

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10

# Alerting Configuration
ALERTING_ENABLED=true
ALERTING_WEBHOOK_URL=
EMAIL_NOTIFICATIONS_ENABLED=false

# Storage Configuration
DATA_CONSISTENCY=eventual
SYNC_INTERVAL_SECONDS=300
VALIDATION_ENABLED=true
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Logging Configuration
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Service URLs (internal communication)
CORE_SERVICE_URL=http://core-processor:8001
DOCUMENT_ROUTER_URL=http://document-router:8002
PROCESSING_PIPELINE_URL=http://processing-pipeline:8003
STORAGE_MANAGER_URL=http://storage-manager:8004

# Network Configuration
DOCKER_NETWORK_NAME=mep-services-network
